{
  "name": "antifund-researcher",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "dev:workers": "vite --mode workers --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit && tsc --project scripts/tsconfig.json",
    "test": "bun test",
    "deploy": "bun run build && wrangler deploy",
    "research": "bun scripts/research.ts",
    "research:worker": "bun scripts/research.ts worker",
    "research:seed": "bun scripts/research.ts seed",
    "research:intake": "bun scripts/intake-runner.ts",
    "research:pipeline": "bun scripts/pipeline.ts",
    "research:scan": "bun scripts/scan-schools.ts",
    "research:signals": "bun scripts/opportunities.ts",
    "research:people": "bun scripts/people.ts",
    "convex:dev": "convex dev",
    "format": "prettier --write src scripts convex docs README.md",
    "research:showcases": "bun scripts/showcase-runner.ts",
    "research:showcases:batch": "bun scripts/showcases.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.10",
    "@tanstack/react-start": "^1.168.18",
    "convex": "^1.35.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.39.0",
    "@openai/codex": "0.161.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "convex-test": "^0.0.60",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "wrangler": "^4.120.0"
  }
}
