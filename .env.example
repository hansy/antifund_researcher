# Convex deployment URL used by the server and local runner.
CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_URL=https://your-deployment.convex.cloud
# Set the same random capability in Convex, Cloudflare server secrets and local runner.
# Never expose as VITE_*, return to visitors, or commit an actual value.
RESEARCH_WRITE_SECRET=
# Local subscription-backed Codex model. Must appear in `codex debug models`.
RESEARCH_MODEL=gpt-6.1-sol
# Optional absolute path to an updated Codex binary.
RESEARCH_CODEX_COMMAND=
